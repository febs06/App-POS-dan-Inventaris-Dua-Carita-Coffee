generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}


model Event {
  id        String     @id @default(cuid())
  name      String
  location  String
  startDate DateTime
  endDate   DateTime
  notes     String?
  status    String     @default("upcoming") // upcoming, ongoing, selesai
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orders    Order[]
  stockLogs StockLog[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  categoryId  String
  price       Float
  cost        Float       @default(0)
  stock       Int         @default(0)
  unit        String      @default("pcs") // pcs, cup, box, porsi
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  stockLogs   StockLog[]
  ingredients ProductIngredient[]
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String   // WhatsApp number
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // percentage, nominal
  value       Float
  minPurchase Float?
  maxDiscount Float?    // Cap diskon untuk persentase
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int?      // Batas pemakaian total
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders      Order[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  orderSource    String      // PO, DIRECT
  eventId        String?
  customerId     String?
  customerName   String?     // Nama pembeli (terutama pada pesanan Direct POS / non-kontak)
  status         String      @default("pending") // pending, diproses, siap diambil, selesai, dibatalkan
  pickupMethod   String?     // ambil di event, COD, ketemu langsung
  pickupDate     DateTime?
  subtotal       Float       @default(0)
  voucherId      String?
  discountAmount Float       @default(0)
  tax            Float       @default(0)
  totalAmount    Float       @default(0)
  isVoided       Boolean     @default(false)
  voidReason     String?
  cashierName    String?     // Nama kasir yang memproses
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  event          Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  voucher        Voucher?    @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  qty        Int
  price      Float    // Harga saat transaksi
  notes      String?
  isVoided   Boolean  @default(false)
  voidReason String?
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  method        String   // cash, qris, transfer
  amount        Float
  isDownPayment Boolean  @default(false)
  paidAt        DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  changeQty Int      // Positif untuk restock/masuk, negatif untuk terjual/keluar
  reason    String   // restock, terjual, dibawa ke event, koreksi
  eventId   String?
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model StoreSetting {
  id            String   @id @default("default")
  storeName     String   @default("Dua Carita Coffee")
  tagline       String?  @default("Bazaar & Pre-Order System")
  logoUrl       String?
  phoneNumber   String?  @default("081234567890")
  address       String?  @default("Jakarta, Indonesia")
  receiptFooter String?  @default("Terima Kasih atas Kunjungan Anda!")
  updatedAt     DateTime @updatedAt
}

model RawMaterial {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("Bahan Minuman") // Bahan Minuman, Sirup & Flavour, Kemasan, Topping, Lainnya
  stock       Float    @default(0)
  unit        String   @default("gram") // gram, ml, pcs, kg, liter, botol, pack
  minStock    Float    @default(10)
  costPerUnit Float    @default(0)
  supplier    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs               RawMaterialLog[]
  opnames            StockOpname[]
  productIngredients ProductIngredient[]
}

model RawMaterialLog {
  id            String      @id @default(cuid())
  rawMaterialId String
  changeQty     Float       // Positif masuk/restock, negatif keluar/pemakaian
  type          String      // restock, pemakaian, rusak, koreksi
  notes         String?
  createdAt     DateTime    @default(now())

  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
}

model StockOpname {
  id            String      @id @default(cuid())
  rawMaterialId String
  systemStock   Float
  physicalStock Float
  difference    Float       // physicalStock - systemStock
  notes         String?
  opnameDate    DateTime    @default(now())
  createdAt     DateTime    @default(now())

  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  pin       String?  // Legacy 4-6 digit PIN (auto-migrated to pinHash)
  pinHash   String?  // Salted PBKDF2/SHA-256 hash
  role      String   @default("KASIR") // OWNER, MANAGER, KASIR, BARISTA
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductIngredient {
  id            String      @id @default(cuid())
  productId     String
  rawMaterialId String
  amount        Float       // Takaran per 1 porsi/produk (misal: 18 untuk gram kopi, 150 untuk ml susu, 1 untuk pcs cup)
  createdAt     DateTime    @default(now())

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([productId, rawMaterialId])
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique // SPL-001, SPL-002, dll
  name        String
  pic         String?  // Person In Charge
  phone       String?  // WhatsApp
  city        String?  @default("Bandung")
  type        String   @default("Bahan Baku") // Bahan Baku, Packaging, Lainnya
  mapsUrl     String?
  status      String   @default("Aktif") // Aktif, Nonaktif
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          SupplierItem[]
  priceHistories SupplierPriceHistory[]
}

model SupplierItem {
  id          String   @id @default(cuid())
  supplierId  String
  category    String   // Kopi, Syrup/Flavor, Creamer, Dairy/Susu, Powder, Operasional, Packaging
  name        String
  qty         Float    @default(1)
  unit        String   // Kg, Pcs, L, Karton, Pack, Bal, Lembar
  price       Float
  priceDate   DateTime @default(now())
  status      String   @default("Aktif")
  notes       String?  // Catatan kemasan/grosir (misal: Per 12 Pcs, Per 100 Pcs, dll)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier        Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  priceHistories  SupplierPriceHistory[]
}

model SupplierPriceHistory {
  id             String        @id @default(cuid())
  supplierId     String
  supplierItemId String?
  itemName       String
  qty            Float         @default(1)
  unit           String
  price          Float
  priceDiff      Float?        @default(0)
  date           DateTime      @default(now())
  notes          String?       // "Harga Awal", "Kenaikan harga", dll
  createdAt      DateTime      @default(now())

  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierItem   SupplierItem? @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
}

model CashRecord {
  id        String   @id @default(cuid())
  seqNo     Int?     // No urut pencatatan
  account   String   @default("CASH") // "CASH" | "QRIS"
  date      DateTime
  name      String
  type      String   // "MASUK" | "KELUAR"
  category  String   // "PENJUALAN" | "BAHAN_BAKU" | "PACKAGING" | "OPERASIONAL" | "PINDAH_SALDO" | "MODAL" | "LAINNYA"
  amount    Float
  balance   Float
  notes     String?
  cashier   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RabItem {
  id         String   @id @default(cuid())
  month      String   // "MEI 2026", "JUNI 2026", "JULI 2026", "AGUSTUS 2026"
  year       Int      @default(2026)
  seqNo      Int?     // No urut item
  name       String
  qty        Float    @default(1)
  unit       String?  // Pcs, Pack, Kg, L, G, Roll, dll
  unitPrice  Float    @default(0)
  totalPrice Float    @default(0)
  notes      String?  // Keterangan spesifikasi/ukuran
  fundedBy   String?  // "DCC", "Febri", "Raihan", "Revan"
  status     String   @default("PLANNED") // "PLANNED" | "REALIZED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



